<!DOCTYPE struts PUBLIC "-//Apache Software Foundation//DTD Struts Configuration 2.5//EN" "struts-2.5.dtd">
<struts>
  <package name="billing" namespace="/api/v8/billing" extends="struts-default">
    <action name="refunds/audit" class="com.acme.legacy.billing.BillingRefundAuditAction" method="execute">
      <result>/WEB-INF/jsp/billing.jsp</result>
    </action>
  </package>
  <package name="orders" namespace="/api/v8/orders" extends="struts-default">
    <action name="fulfillment/reprice" class="com.acme.legacy.orders.OrderFulfillmentAction" method="execute">
      <result>/WEB-INF/jsp/orders.jsp</result>
    </action>
  </package>
</struts>
