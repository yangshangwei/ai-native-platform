  "id": "legacy-project-understanding-restify-e2e",
  "title": "Legacy project understanding keeps Restify context focused",
  "description": "Runs the real scanner against a small Restify service, then verifies ContextPack selects the requested route, service/repository graph evidence, and tests without leaking unrelated domains or raw inventory context.",
  "kind": "legacy_project_understanding_fixture",
  "input": {
    "projectId": "proj_eval_legacy_restify",
    "title": "Update legacy Restify billing reconciliation",
    "stage": "implementation",
    "taskBrief": "Fix billing invoice reconciliation in the legacy billing endpoint and update billing tests.",
    "inventoryLimits": {
      "maxCapturedFiles": 24,
      "maxFileBytes": 8192,
      "maxTotalBytes": 65536
    },
    "files": [
      {
        "path": "src/routes/restify-server.ts",
        "content": "import restify from \"restify\";\nimport { reconcileInvoice, auditInvoice } from \"../billing/controller\";\nimport { showCustomer } from \"../customers/controller\";\nimport { dailyReport } from \"../reports/controller\";\nconst server = restify.createServer();\nserver.post(\"/api/v1/billing/invoices/:invoiceId/reconcile\", reconcileInvoice);\nserver.get(\"/api/v1/billing/invoices/:invoiceId/audit\", auditInvoice);\nserver.get(\"/api/v1/customers/:customerId\", showCustomer);\nserver.get(\"/api/v1/reports/daily\", dailyReport);\n"
      },
      {
        "path": "src/billing/controller.ts",
        "content": "import { BillingService } from \"./service\";\n\nexport function reconcileInvoice(req: unknown) {\n  const service = new BillingService();\n  return service.reconcileInvoice(\"inv_1\");\n}\n\nexport function auditInvoice(req: unknown) {\n  const service = new BillingService();\n  return service.auditInvoice(\"inv_1\");\n}\n"
      },
      {
        "path": "src/billing/service.ts",
        "content": "import { BillingRepository } from \"./repository\";\n\nexport class BillingService {\n  reconcileInvoice(invoiceId: string) {\n    const repository = new BillingRepository();\n    return repository.markReconciled(invoiceId);\n  }\n\n  auditInvoice(invoiceId: string) {\n    const repository = new BillingRepository();\n    return repository.loadAudit(invoiceId);\n  }\n}\n"
      },
      {
        "path": "src/billing/repository.ts",
        "content": "export class BillingRepository {\n  markReconciled(invoiceId: string) {\n    return invoiceId;\n  }\n\n  loadAudit(invoiceId: string) {\n    return invoiceId;\n  }\n}\n"
      },
      {
        "path": "src/customers/controller.ts",
        "content": "export function showCustomer(req: unknown) {\n  return { customerId: \"cust_1\" };\n}\n"
      },
      {
        "path": "src/reports/controller.ts",
        "content": "export function dailyReport(req: unknown) {\n  return { status: \"ready\" };\n}\n"
      },
      {
        "path": "test/billing-restify.test.ts",
        "content": "import { describe, expect, it } from \"vitest\";\n\ndescribe(\"billing Restify route\", () => {\n  it(\"reconciles invoices through the billing endpoint\", () => expect(true).toBe(true));\n});\n"
      },
      {
        "path": "test/customers-restify.test.ts",
        "content": "import { describe, expect, it } from \"vitest\";\n\ndescribe(\"customer Restify route\", () => {\n  it(\"loads the customer profile endpoint\", () => expect(true).toBe(true));\n});\n"
      },
      {
        "path": "test/reports-restify.test.ts",
        "content": "import { describe, expect, it } from \"vitest\";\n\ndescribe(\"reports Restify route\", () => {\n  it(\"loads daily report endpoint\", () => expect(true).toBe(true));\n});\n"
      },
      {
        "path": ".env",
        "content": "RESTIFY_SECRET=secret\n"
      }
    ]
  },
