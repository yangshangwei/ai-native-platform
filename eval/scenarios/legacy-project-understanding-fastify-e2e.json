{
  "schemaVersion": "ainp.eval.scenario.v1",
  "id": "legacy-project-understanding-fastify-e2e",
  "title": "Legacy project understanding keeps Fastify plugin context focused",
  "description": "Runs the real scanner against a small Fastify plugin service, then verifies ContextPack selects registered prefix routes, service/repository graph evidence, and tests without leaking unrelated domains or raw inventory context.",
  "kind": "legacy_project_understanding_fixture",
  "input": {
    "projectId": "proj_eval_legacy_fastify",
    "title": "Update legacy Fastify billing reconciliation",
    "stage": "implementation",
    "taskBrief": "Fix billing invoice reconciliation in the legacy Fastify endpoint and update billing tests.",
    "inventoryLimits": {
      "maxCapturedFiles": 24,
      "maxFileBytes": 8192,
      "maxTotalBytes": 65536
    },
    "files": [
      {
        "path": "src/routes/fastify-server.ts",
        "content": "import createFastify from \"fastify\";\nimport billingRoutes from \"../billing/routes\";\nimport { customerRoutes } from \"../customers/routes\";\nimport { reportsRoutes } from \"../reports/routes\";\nconst app = createFastify();\napp.register(billingRoutes, { prefix: \"/api/v1/billing\" });\napp.register(customerRoutes, { prefix: \"/api/v1/customers\" });\napp.register(reportsRoutes, { prefix: \"/api/v1/reports\" });\n"
      },
      {
        "path": "src/billing/routes.ts",
        "content": "import { reconcileInvoice, auditInvoice } from \"./controller\";\nexport default async function billingRoutes(fastify) {\n  fastify.post(\"/invoices/:invoiceId/reconcile\", reconcileInvoice);\n  fastify.get(\"/invoices/:invoiceId/audit\", auditInvoice);\n}\n"
      },
      {
        "path": "src/customers/routes.ts",
        "content": "import { showCustomer } from \"./controller\";\nexport function customerRoutes(fastify) {\n  fastify.get(\"/:customerId\", showCustomer);\n}\n"
      },
      {
        "path": "src/reports/routes.ts",
        "content": "import { dailyReport } from \"./controller\";\nexport const reportsRoutes = async (fastify) => {\n  fastify.get(\"/daily\", dailyReport);\n};\n"
      },
      {
        "path": "src/billing/controller.ts",
        "content": "import { BillingService } from \"./service\";\n\nexport function reconcileInvoice(req: unknown) {\n  const service = new BillingService();\n  return service.reconcileInvoice(\"inv_1\");\n}\n\nexport function auditInvoice(req: unknown) {\n  const service = new BillingService();\n  return service.auditInvoice(\"inv_1\");\n}\n"
      },
      {
        "path": "src/billing/service.ts",
        "content": "import { BillingRepository } from \"./repository\";\n\nexport class BillingService {\n  reconcileInvoice(invoiceId: string) {\n    const repository = new BillingRepository();\n    return repository.markReconciled(invoiceId);\n  }\n\n  auditInvoice(invoiceId: string) {\n    const repository = new BillingRepository();\n    return repository.loadAudit(invoiceId);\n  }\n}\n"
      },
      {
        "path": "src/billing/repository.ts",
        "content": "export class BillingRepository {\n  markReconciled(invoiceId: string) {\n    return invoiceId;\n  }\n\n  loadAudit(invoiceId: string) {\n    return invoiceId;\n  }\n}\n"
      },
      {
        "path": "src/customers/controller.ts",
        "content": "export function showCustomer(req: unknown) {\n  return { customerId: \"cust_1\" };\n}\n"
      },
      {
        "path": "src/reports/controller.ts",
        "content": "export function dailyReport(req: unknown) {\n  return { status: \"ready\" };\n}\n"
      },
      {
        "path": "test/billing-fastify.test.ts",
        "content": "import { describe, expect, it } from \"vitest\";\n\ndescribe(\"billing Fastify plugin route\", () => {\n  it(\"reconciles invoices through the billing endpoint\", () => expect(true).toBe(true));\n});\n"
      },
      {
        "path": "test/customers-fastify.test.ts",
        "content": "import { describe, expect, it } from \"vitest\";\n\ndescribe(\"customer Fastify plugin route\", () => {\n  it(\"loads the customer profile endpoint\", () => expect(true).toBe(true));\n});\n"
      },
      {
        "path": "test/reports-fastify.test.ts",
        "content": "import { describe, expect, it } from \"vitest\";\n\ndescribe(\"reports Fastify plugin route\", () => {\n  it(\"loads daily report endpoint\", () => expect(true).toBe(true));\n});\n"
      },
      {
        "path": ".env",
        "content": "FASTIFY_SECRET=secret\n"
      }
    ]
  },
