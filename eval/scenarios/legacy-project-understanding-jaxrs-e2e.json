      {
        "path": "src/main/java/com/acme/legacy/LegacyApplication.java",
        "content": "package com.acme.legacy;\n\n@ApplicationPath(\"/api\")\npublic class LegacyApplication extends Application {}\n"
      },
      {
        "path": "src/main/java/com/acme/legacy/billing/BillingResource.java",
        "content": "package com.acme.legacy.billing;\n\n@Path(\"/v1/billing\")\npublic class BillingResource {\n  private final BillingService billingService = new BillingService();\n\n  @POST\n  @Path(\"/invoices/{invoiceId}/reconcile\")\n  public Response reconcileInvoice(String invoiceId) {\n    return Response.ok(billingService.reconcile(invoiceId)).build();\n  }\n\n  @GET\n  @Path(\"/invoices/{invoiceId}/audit\")\n  public Response auditInvoice(String invoiceId) {\n    return Response.ok(billingService.audit(invoiceId)).build();\n  }\n}\n"
      },
      {
        "path": "src/main/java/com/acme/legacy/billing/BillingService.java",
        "content": "package com.acme.legacy.billing;\n\npublic class BillingService {\n  private final BillingRepository billingRepository = new BillingRepository();\n\n  public ReconciliationResult reconcile(String invoiceId) {\n    return billingRepository.markReconciled(invoiceId);\n  }\n\n  public AuditTrail audit(String invoiceId) {\n    return billingRepository.auditTrail(invoiceId);\n  }\n}\n"
      },
      {
        "path": "src/main/java/com/acme/legacy/billing/BillingRepository.java",
        "content": "package com.acme.legacy.billing;\n\npublic class BillingRepository {\n  public ReconciliationResult markReconciled(String invoiceId) {\n    return new ReconciliationResult(invoiceId, \"reconciled\");\n  }\n\n  public AuditTrail auditTrail(String invoiceId) {\n    return new AuditTrail(invoiceId);\n  }\n}\n"
      },
      {
        "path": "src/main/java/com/acme/legacy/customers/CustomerResource.java",
        "content": "package com.acme.legacy.customers;\n\n@Path(\"/v1/customers\")\npublic class CustomerResource {\n  @GET\n  @Path(\"/{customerId}\")\n  public Response showCustomer(String customerId) {\n    return Response.ok(customerId).build();\n  }\n}\n"
      },
      {
        "path": "src/main/java/com/acme/legacy/reports/ReportResource.java",
        "content": "package com.acme.legacy.reports;\n\n@Path(\"/v1/reports\")\npublic class ReportResource {\n  @GET\n  @Path(\"/daily\")\n  public Response dailyReport() {\n    return Response.ok(\"daily\").build();\n  }\n}\n"
      },
      {
        "path": "src/test/java/com/acme/legacy/billing/BillingResourceTest.java",
        "content": "package com.acme.legacy.billing;\n\nclass BillingResourceTest {\n  void reconcilesInvoicesThroughBillingResource() {}\n}\n"
      },
