  "input": {
    "projectId": "proj_eval_legacy_struts",
    "title": "Update legacy Struts billing reconciliation",
    "stage": "implementation",
    "taskBrief": "Fix billing invoice reconciliation in the legacy Struts action and update billing tests.",
