    "files": [
      {
        "path": "src/main/resources/struts.xml",
        "content": "<!DOCTYPE struts PUBLIC \"-//Apache Software Foundation//DTD Struts Configuration 2.5//EN\" \"struts-2.5.dtd\">\n<struts>\n  <package name=\"billing\" namespace=\"/api/v1/billing\" extends=\"struts-default\">\n    <action name=\"invoices/reconcile\" class=\"com.acme.legacy.billing.ReconcileInvoiceAction\" method=\"execute\">\n      <result>/WEB-INF/jsp/billing.jsp</result>\n    </action>\n  </package>\n  <package name=\"reports\" namespace=\"/api/v1/reports\" extends=\"struts-default\">\n    <action name=\"daily\" class=\"com.acme.legacy.reports.DailyReportAction\">\n      <result>/WEB-INF/jsp/reports.jsp</result>\n    </action>\n  </package>\n</struts>\n"
      },
      {
        "path": "src/main/webapp/WEB-INF/struts-config.xml",
        "content": "<struts-config>\n  <action-mappings>\n    <action path=\"/api/v1/customers/profile\" type=\"com.acme.legacy.customers.CustomerProfileAction\" />\n  </action-mappings>\n</struts-config>\n"
      },
      {
        "path": "src/main/java/com/acme/legacy/billing/ReconcileInvoiceAction.java",
        "content": "package com.acme.legacy.billing;\n\npublic class ReconcileInvoiceAction extends ActionSupport {\n  private final BillingService billingService = new BillingService();\n\n  public String execute() {\n    billingService.reconcile(invoiceId);\n    return SUCCESS;\n  }\n}\n"
      },
      {
        "path": "src/main/java/com/acme/legacy/billing/BillingService.java",
        "content": "package com.acme.legacy.billing;\n\npublic class BillingService {\n  private final BillingRepository billingRepository = new BillingRepository();\n\n  public ReconciliationResult reconcile(String invoiceId) {\n    return billingRepository.markReconciled(invoiceId);\n  }\n}\n"
      },
      {
        "path": "src/main/java/com/acme/legacy/billing/BillingRepository.java",
        "content": "package com.acme.legacy.billing;\n\npublic class BillingRepository {\n  public ReconciliationResult markReconciled(String invoiceId) {\n    return new ReconciliationResult(invoiceId, \"reconciled\");\n  }\n}\n"
      },
      {
        "path": "src/main/java/com/acme/legacy/customers/CustomerProfileAction.java",
        "content": "package com.acme.legacy.customers;\n\npublic class CustomerProfileAction extends Action {\n  public ActionForward execute() {\n    return mapping.findForward(\"profile\");\n  }\n}\n"
      },
      {
        "path": "src/main/java/com/acme/legacy/reports/DailyReportAction.java",
        "content": "package com.acme.legacy.reports;\n\npublic class DailyReportAction extends ActionSupport {\n  public String execute() {\n    return SUCCESS;\n  }\n}\n"
      },
      {
        "path": "src/test/java/com/acme/legacy/billing/ReconcileInvoiceActionTest.java",
        "content": "package com.acme.legacy.billing;\n\nclass ReconcileInvoiceActionTest {\n  void reconcilesInvoicesThroughStrutsAction() {}\n}\n"
      },
      {
        "path": "src/test/java/com/acme/legacy/customers/CustomerProfileActionTest.java",
        "content": "package com.acme.legacy.customers;\n\nclass CustomerProfileActionTest {\n  void loadsCustomerProfile() {}\n}\n"
      },
      {
        "path": "src/test/java/com/acme/legacy/reports/DailyReportActionTest.java",
        "content": "package com.acme.legacy.reports;\n\nclass DailyReportActionTest {\n  void loadsDailyReports() {}\n}\n"
      },
      {
