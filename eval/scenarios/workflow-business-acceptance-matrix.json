        "businessMatrixScenarioTypes": ["core", "boundary", "exception"],
        "commandDigestBacked": true,
        "completionReportGenerated": true,
        "completionReportHasStatusAtGeneration": true,
        "completionReportHasBusinessMatrix": true,
        "retroReportGenerated": true
      }
    },
    {
      "id": "captcha-test-only-rejected",
