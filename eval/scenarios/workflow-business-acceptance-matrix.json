        "acceptanceGateStatus": "fail",
        "acceptanceRuleStatuses": {
          "acceptance.test_gate_passed": "pass",
          "acceptance.business_matrix_present": "fail",
          "acceptance.business_matrix_scenarios_present": "fail"
