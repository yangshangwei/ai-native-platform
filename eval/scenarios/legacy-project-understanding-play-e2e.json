      },
      {
        "path": "app/services/BillingService.java",
        "content": "package services;\n\npublic class BillingService {\n  private final BillingRepository billingRepository = new BillingRepository();\n\n  public RefundApproval approveRefund(String refundId) {\n    return billingRepository.approveRefund(refundId);\n  }\n}\n"
      },
      {
        "path": "app/repositories/BillingRepository.java",
        "content": "package repositories;\n\npublic class BillingRepository {\n  public RefundApproval approveRefund(String refundId) {\n    return new RefundApproval(refundId);\n  }\n}\n"
      },
      {
        "path": "test/controllers/BillingControllerTest.java",
        "content": "package controllers;\n\nclass BillingControllerTest {\n  void approvesRefundsThroughPlayRoute() {}\n}\n"
      },
      {
        "path": "test/controllers/CustomerControllerTest.java",
        "content": "package controllers;\n\nclass CustomerControllerTest {\n  void loadsCustomerProfileThroughPlayRoute() {}\n}\n"
      },
      {
        "path": ".env",
        "content": "PLAY_SECRET=secret\n"
      }
    ]
