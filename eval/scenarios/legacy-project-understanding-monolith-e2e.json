      {
        "path": "package.json",
        "content": "{\"name\":\"legacy-monolith\",\"scripts\":{\"test\":\"jest\",\"build\":\"tsc --noEmit\",\"lint\":\"eslint .\"}}"
      },
      {
        "path": "src/app.js",
        "content": "const express = require('express');\nconst billingRoutes = require('./routes/billing');\nconst customerRoutes = require('./routes/customers');\nconst reportRoutes = require('./routes/reports');\nconst app = express();\n\napp.use('/api/v1/billing', billingRoutes);\napp.use('/api/v1/customers', customerRoutes);\napp.use('/api/v1/reports', reportRoutes);\n\nmodule.exports = app;\n"
      },
      {
        "path": "src/routes/billing.js",
        "content": "const express = require('express');\nconst billingController = require('../controllers/billing-controller');\nconst router = express.Router();\n\nrouter.post('/invoices/:invoiceId/reconcile', billingController.reconcileInvoice);\nrouter.get('/invoices/:invoiceId/audit', billingController.auditInvoice);\n\nmodule.exports = router;\n"
      },
      {
        "path": "src/controllers/billing-controller.js",
        "content": "const BillingService = require('../services/billing-service');\n\nmodule.exports = {\n  reconcileInvoice(req, res) {\n    return BillingService.reconcile(req.params.invoiceId);\n  },\n\n  auditInvoice(req, res) {\n    return BillingService.audit(req.params.invoiceId);\n  }\n};\n"
      },
      {
        "path": "src/services/billing-service.js",
        "content": "const BillingRepository = require('../repositories/billing-repository');\n\nmodule.exports = {\n  reconcile(invoiceId) {\n    return BillingRepository.markReconciled(invoiceId);\n  },\n\n  audit(invoiceId) {\n    return BillingRepository.auditTrail(invoiceId);\n  }\n};\n"
      },
      {
        "path": "src/repositories/billing-repository.js",
        "content": "module.exports = {\n  markReconciled(invoiceId) {\n    return { invoiceId, status: 'reconciled' };\n  },\n\n  auditTrail(invoiceId) {\n    return [];\n  }\n};\n"
      },
      {
        "path": "src/routes/customers.js",
        "content": "const express = require('express');\nconst customerController = require('../controllers/customer-controller');\nconst router = express.Router();\n\nrouter.get('/:customerId', customerController.showCustomer);\nrouter.post('/', customerController.createCustomer);\n\nmodule.exports = router;\n"
      },
      {
        "path": "src/controllers/customer-controller.js",
        "content": "const CustomerService = require('../services/customer-service');\n\nmodule.exports = {\n  showCustomer(req, res) {\n    return CustomerService.show(req.params.customerId);\n  },\n\n  createCustomer(req, res) {\n    return CustomerService.create(req.body);\n  }\n};\n"
      },
      {
        "path": "src/services/customer-service.js",
        "content": "module.exports = {\n  show(customerId) {\n    return { customerId };\n  },\n\n  create(input) {\n    return { id: 'new-customer', ...input };\n  }\n};\n"
      },
      {
        "path": "src/routes/reports.js",
        "content": "const express = require('express');\nconst reportController = require('../controllers/report-controller');\nconst router = express.Router();\n\nrouter.get('/daily', reportController.dailyReport);\n\nmodule.exports = router;\n"
      },
      {
        "path": "src/controllers/report-controller.js",
        "content": "module.exports = {\n  dailyReport(req, res) {\n    return { status: 'ok' };\n  }\n};\n"
      },
      {
        "path": "tests/billing-reconciliation.test.js",
        "content": "describe('billing reconciliation', () => {\n  it('reconciles invoices through the legacy billing route', () => expect(true).toBe(true));\n});\n"
      },
      {
        "path": "tests/customers.test.js",
        "content": "describe('customers api', () => {\n  it('loads customer profile data', () => expect(true).toBe(true));\n});\n"
      },
      {
        "path": "tests/reports.test.js",
        "content": "describe('reports api', () => {\n  it('loads daily reports', () => expect(true).toBe(true));\n});\n"
      },
      {
        "path": ".env",
        "content": "DATABASE_URL=postgres://secret\n"
      }
    ]
